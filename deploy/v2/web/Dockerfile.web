# syntax=docker/dockerfile:1
# All-in-one build of the RustDesk v2 web client image from the repository's
# own flutter/ tree (current UI, Flutter 3.24.5):
#   codec bundle -> JS protocol stack -> flutter build web -> Caddy.
#
# Build context must be the REPOSITORY ROOT:
#   docker build -f deploy/v2/web/Dockerfile.web -t rustdesk-web-v2 .
#   docker run -p 8080:80 -e SITE_ADDRESS=http://:80 rustdesk-web-v2
#
# Or from this directory: docker compose up -d  (compose sets the context)

ARG BASE_HREF=/
ARG FLUTTER_VERSION=3.24.5

# ---- source ------------------------------------------------------------------
FROM alpine:3.20 AS src
WORKDIR /src
# flutter/ holds the app (lib/, web/, pubspec); libs/hbb_common/protos,
# src/lang, src/client.rs and Cargo.toml feed the JS codegen scripts.
COPY flutter /src/flutter
COPY libs/hbb_common/protos /src/libs/hbb_common/protos
COPY src/lang /src/src/lang
COPY src/client.rs /src/src/client.rs
COPY Cargo.toml /src/Cargo.toml
COPY deploy/v2/fetch-codecs.sh /src/fetch-codecs.sh
COPY deploy/v2/web/config.js /src/flutter/web/config.js

# ---- codec bundle + JS protocol stack ---------------------------------------
FROM node:22-bookworm AS js
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python-is-python3 protobuf-compiler curl ca-certificates unzip \
 && rm -rf /var/lib/apt/lists/*
COPY --from=src /src /src
RUN bash /src/fetch-codecs.sh /src/flutter/web
WORKDIR /src/flutter/web/js
RUN rm -f package-lock.json \
 && npm install \
 && npm install --no-save --no-package-lock typescript@6.0.3 @types/node@26.3.0 vite@7.3.6 libsodium@0.7.13 libsodium-wrappers@0.7.13 \
 && npm run build \
 && test -f dist/index.js && test -f dist/vendor.js

# ---- flutter build web -------------------------------------------------------
FROM debian:bookworm-slim AS flutter
ARG FLUTTER_VERSION
ARG BASE_HREF
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl git ca-certificates xz-utils libglu1-mesa \
 && rm -rf /var/lib/apt/lists/*
RUN curl -sL "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
    | tar xJ -C /opt
ENV PATH="/opt/flutter/bin:$PATH"
RUN git config --global --add safe.directory /opt/flutter \
 && flutter precache --web
COPY --from=js /src /src
WORKDIR /src/flutter
RUN flutter pub get \
 && flutter build web --release --base-href "$BASE_HREF" \
 && rm -rf /src/flutter/build/web/js \
 && mkdir -p /src/flutter/build/web/js \
 && cp -r /src/flutter/web/js/dist /src/flutter/build/web/js/dist

# ---- control room sidecar (stdlib; only started when CONTROL_ROOM=1) -------
FROM golang:1.22-bookworm AS controlroom
WORKDIR /src
COPY deploy/v2/controlroom /src
RUN CGO_ENABLED=0 go test ./... \
 && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /rustdesk-web-controlroom ./cmd/controlroom

# ---- runtime: Caddy serving static files + /ws/* proxy -----------------------
FROM caddy:2-alpine
COPY --from=flutter /src/flutter/build/web /srv
COPY --from=controlroom /rustdesk-web-controlroom /usr/bin/rustdesk-web-controlroom
COPY deploy/v2/web/Caddyfile /etc/caddy/Caddyfile
COPY deploy/v2/web/control.handle /etc/caddy/control.handle
COPY deploy/v2/web/docker-entrypoint.sh /docker-entrypoint.sh
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
