# ---- compose one-command deployment ------------------------------------------

# Site address of the web client:
#   http://:80              plain HTTP (intranet, no certificate) - default
#   http://192.168.1.10     plain HTTP bound to an intranet IP
#   rustdesk.example.com    automatic HTTPS via Caddy (map ports 80+443 then)
SITE_ADDRESS=http://:80

# Host port mapped to the web client page.
WEB_PORT=8080

# Public address of THIS server as seen by the controlled/native clients,
# e.g. 192.168.1.10:21117 or rustdesk.example.com:21117 (hbbs -r).
# Empty = hbbs derives the relay as <its own host>:21117, which is correct
# when clients reach this host directly.
RELAY_SERVER=

# Optional default server baked into the web client at container start.
# Empty = same origin (recommended: the web container proxies /ws/*).
RUSTDESK_SERVER=

# Optional exclusive control room (first joiner controls; others view-only
# until the controller approves). Off by default so existing sessions are unchanged.
# Sidecar listens on 127.0.0.1:8099 inside the web container (not published).
# Browsers use same-origin /control; Caddy reverse-proxies when this is set.
# CONTROL_ROOM=1
# CONTROL_ROOM_AUTO_APPROVE=1   # process-wide auto-approve (not per-browser)

# Base href the web client is built with. Only change for the portal mode,
# e.g. BASE_HREF=/rustdesk/ when mounting under a sub-path of an existing
# site. Requires a rebuild of the web image.
BASE_HREF=/
