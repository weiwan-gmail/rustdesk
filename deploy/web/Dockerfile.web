# syntax=docker/dockerfile:1
# All-in-one build of the RustDesk web client image:
#   source tarball -> privatization patch -> codec bundle -> JS protocol stack
#   -> flutter build web -> Caddy serving static files + WS proxy.
#
#   docker build -f Dockerfile.web -t rustdesk-web .
#   docker run -p 8080:80 -e SITE_ADDRESS=http://:80 rustdesk-web
#
# Build context must be this directory (deploy/web).

ARG REPO_URL=https://github.com/rustdesk/rustdesk
ARG WEB_CLIENT_COMMIT=96f41fcc02dd076bff12053430b90ad2fc43a283
ARG BASE_HREF=/
ARG FLUTTER_VERSION=3.19.6

# ---- source at the pinned commit + patch ------------------------------------
FROM alpine:3.20 AS src
ARG REPO_URL
ARG WEB_CLIENT_COMMIT
RUN apk add --no-cache curl patch
WORKDIR /src
RUN curl -sL "$REPO_URL/archive/$WEB_CLIENT_COMMIT.tar.gz" | tar xz --strip-components=1
COPY patches/ /patches/
RUN patch -p1 < /patches/0001-private-web-client.patch
COPY config.js flutter/web/config.js

# ---- codec bundle + JS protocol stack ---------------------------------------
FROM node:22-bookworm AS js
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python-is-python3 protobuf-compiler curl ca-certificates unzip \
 && rm -rf /var/lib/apt/lists/*
COPY --from=src /src /src
COPY fetch-codecs.sh /tmp/fetch-codecs.sh
RUN bash /tmp/fetch-codecs.sh /src/flutter/web
WORKDIR /src/flutter/web/js
COPY pin-js-deps.sh /tmp/pin-js-deps.sh
RUN bash /tmp/pin-js-deps.sh package.json \
 && rm -f yarn.lock package-lock.json \
 && npm install \
 && npm install --no-save --no-package-lock typescript@6.0.3 @types/node@26.3.0 libsodium@0.7.13 libsodium-wrappers@0.7.13 \
 && npm run build

# ---- flutter build web -------------------------------------------------------
FROM debian:bookworm-slim AS flutter
ARG FLUTTER_VERSION
ARG BASE_HREF
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl git ca-certificates xz-utils libglu1-mesa \
 && rm -rf /var/lib/apt/lists/*
RUN curl -sL "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
    | tar xJ -C /opt
ENV PATH="/opt/flutter/bin:$PATH"
RUN git config --global --add safe.directory /opt/flutter \
 && flutter precache --web
COPY --from=js /src /src
WORKDIR /src/flutter
RUN flutter build web --release --base-href "$BASE_HREF"

# ---- runtime: Caddy serving static files + /ws/* proxy -----------------------
FROM caddy:2-alpine
COPY --from=flutter /src/flutter/build/web /srv
COPY Caddyfile /etc/caddy/Caddyfile
COPY docker-entrypoint.sh /docker-entrypoint.sh
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
